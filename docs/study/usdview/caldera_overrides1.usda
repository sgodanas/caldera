#usda 1.0
(
    "usd file created with the example script from the caldera data set."
    endTimeCode = 900
    framesPerSecond = 30
    metersPerUnit = 0.0254
    startTimeCode = 0
    subLayers = [
        @/Users/sgoda/code/activision/caldera/caldera.usda@
    ]
    timeCodesPerSecond = 30
    upAxis = "Z"
)

over "players" (
    active = false
)
{
    over "endpoints" (
        active = false
    )
    {
    }
}

over "world"
{
    over "mp_wz_island"
    {
        over "mp_wz_island_paths"
        {
            over "mp_wz_island_geo"
            {
                over "st_main"
                {
                    over "st_b" (
                        variants = {
                            string districtLod = "full"
                        }
                    )
                    {
                    }
                }

                over "map_tile_b" (
                    variants = {
                        string districtLod = "full"
                    }
                )
                {
                }
            }
        }
    }
}

